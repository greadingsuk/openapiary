{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Open Apiary design tokens — warm honey + kraft on a light paper canvas. Light-only theme.",
  "color": {
    "honey": {
      "50":  { "$type": "color", "$value": "#fff8e6" },
      "100": { "$type": "color", "$value": "#ffe9a8" },
      "200": { "$type": "color", "$value": "#ffd76b" },
      "300": { "$type": "color", "$value": "#ffc233" },
      "400": { "$type": "color", "$value": "#f5a91f", "$description": "Primary accent" },
      "500": { "$type": "color", "$value": "#d98a0c" },
      "600": { "$type": "color", "$value": "#a96809" },
      "700": { "$type": "color", "$value": "#774905" },
      "800": { "$type": "color", "$value": "#4d2f03" }
    },
    "kraft": {
      "50":  { "$type": "color", "$value": "#f5efe2" },
      "100": { "$type": "color", "$value": "#e8dcc4" },
      "200": { "$type": "color", "$value": "#d8c7a6" },
      "300": { "$type": "color", "$value": "#c9b896" },
      "400": { "$type": "color", "$value": "#a8966e" },
      "500": { "$type": "color", "$value": "#8a7b5e" },
      "600": { "$type": "color", "$value": "#5e523c" },
      "700": { "$type": "color", "$value": "#3a3328" }
    },
    "surface": {
      "base": { "$type": "color", "$value": "#fffdf7" },
      "1":    { "$type": "color", "$value": "#fff8e6" },
      "2":    { "$type": "color", "$value": "#f5efe2" },
      "3":    { "$type": "color", "$value": "#e8dcc4" }
    },
    "text": {
      "primary":   { "$type": "color", "$value": "#1a1410" },
      "muted":     { "$type": "color", "$value": "#5e523c" },
      "subtle":    { "$type": "color", "$value": "#6e6047" },
      "on-accent": { "$type": "color", "$value": "#14100c" }
    },
    "data": {
      "weight":   { "$type": "color", "$value": "#b8780a" },
      "weight-2": { "$type": "color", "$value": "#8a5a06" },
      "battery":  { "$type": "color", "$value": "#5f9145" },
      "temp":     { "$type": "color", "$value": "#d2581f" },
      "humidity": { "$type": "color", "$value": "#3f8a83" },
      "alert":    { "$type": "color", "$value": "#cf3a3f" }
    },
    "semantic": {
      "success": { "$type": "color", "$value": "#5f9145" },
      "warning": { "$type": "color", "$value": "#c47d0a" },
      "danger":  { "$type": "color", "$value": "#cf3a3f" },
      "info":    { "$type": "color", "$value": "#5e523c" }
    }
  },
  "glass": {
    "fill":      { "$type": "color", "$value": "rgba(26,20,16,0.04)" },
    "fill-2":    { "$type": "color", "$value": "rgba(26,20,16,0.06)" },
    "border":    { "$type": "color", "$value": "rgba(26,20,16,0.12)" },
    "highlight": { "$type": "color", "$value": "rgba(245,169,31,0.22)" },
    "blur":      { "$type": "dimension", "$value": "18px" },
    "blur-lg":   { "$type": "dimension", "$value": "24px" }
  },
  "radius": {
    "sm":   { "$type": "dimension", "$value": "8px" },
    "md":   { "$type": "dimension", "$value": "14px" },
    "lg":   { "$type": "dimension", "$value": "22px" },
    "xl":   { "$type": "dimension", "$value": "32px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "24px" },
    "6": { "$type": "dimension", "$value": "32px" },
    "7": { "$type": "dimension", "$value": "48px" },
    "8": { "$type": "dimension", "$value": "64px" }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["Sora", "-apple-system", "Segoe UI", "Roboto", "sans-serif"] },
      "body":    { "$type": "fontFamily", "$value": ["Inter", "-apple-system", "Segoe UI", "Roboto", "sans-serif"] },
      "mono":    { "$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "SF Mono", "Consolas", "monospace"] }
    },
    "size": {
      "2xs":  { "$type": "dimension", "$value": "11px" },
      "xs":   { "$type": "dimension", "$value": "12px" },
      "sm":   { "$type": "dimension", "$value": "14px" },
      "md":   { "$type": "dimension", "$value": "16px" },
      "lg":   { "$type": "dimension", "$value": "20px" },
      "xl":   { "$type": "dimension", "$value": "24px" },
      "2xl":  { "$type": "dimension", "$value": "32px" },
      "3xl":  { "$type": "dimension", "$value": "44px" },
      "dial": { "$type": "dimension", "$value": "56px" }
    },
    "weight": {
      "regular":  { "$type": "number", "$value": 400 },
      "medium":   { "$type": "number", "$value": 500 },
      "semibold": { "$type": "number", "$value": 600 },
      "bold":     { "$type": "number", "$value": 700 }
    }
  },
  "shadow": {
    "1": { "$type": "shadow", "$value": "0 1px 2px rgba(58,51,40,0.12)" },
    "2": { "$type": "shadow", "$value": "0 4px 12px rgba(58,51,40,0.14)" },
    "3": { "$type": "shadow", "$value": "0 12px 32px rgba(58,51,40,0.16)" },
    "glow": { "$type": "shadow", "$value": "0 0 24px rgba(245,169,31,0.30)" }
  },
  "motion": {
    "ease-standard":   { "$type": "cubicBezier", "$value": [0.4, 0, 0.2, 1] },
    "ease-decelerate": { "$type": "cubicBezier", "$value": [0, 0, 0.2, 1] },
    "ease-spring":     { "$type": "cubicBezier", "$value": [0.34, 1.56, 0.64, 1] },
    "duration-fast": { "$type": "duration", "$value": "150ms" },
    "duration-base": { "$type": "duration", "$value": "250ms" },
    "duration-slow": { "$type": "duration", "$value": "400ms" },
    "duration-dial": { "$type": "duration", "$value": "800ms" }
  }
}
